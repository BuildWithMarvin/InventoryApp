<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="InventoryApp.Maui.Views.LoginPage"
             BackgroundColor="{AppThemeBinding Light=#F4F6F9, Dark=#1E1E1E}">

    <Grid RowDefinitions="*, Auto, *">
        
        <Border Grid.Row="1"
                Margin="24"
                Padding="28"
                StrokeShape="RoundRectangle 12"
                StrokeThickness="1"
                Stroke="{AppThemeBinding Light=#E0E0E0, Dark=#333333}"
                BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#2D2D2D}"
                MaximumWidthRequest="400"
                HorizontalOptions="Center">

            <VerticalStackLayout Spacing="20">

               
                <VerticalStackLayout Spacing="6" HorizontalOptions="Center">
                    <Label Text="📦" 
                           FontSize="40" 
                           HorizontalOptions="Center" />

                    <Label Text="Inventory App" 
                           FontSize="22" 
                           FontAttributes="Bold" 
                           HorizontalOptions="Center" 
                           TextColor="{AppThemeBinding Light=#1A1A1A, Dark=#FFFFFF}" />

                    <Label Text="Bitte Mitarbeiterausweis scannen" 
                           FontSize="14" 
                           TextColor="{AppThemeBinding Light=#666666, Dark=#AAAAAA}" 
                           HorizontalOptions="Center" />
                </VerticalStackLayout>

              
                <Border StrokeShape="RoundRectangle 8"
                        Stroke="{AppThemeBinding Light=#CCCCCC, Dark=#555555}"
                        StrokeThickness="1"
                        Padding="4,0">

                    <Entry x:Name="BarcodeEntry"
                           Placeholder="Ausweis-Barcode..."
                           Text="{Binding BadgeBarcode}"
                           ReturnCommand="{Binding LoginCommand}"
                           FontSize="16"
                           HeightRequest="48"
                           VerticalOptions="Center"
                           ClearButtonVisibility="WhileEditing" />
                </Border>

                
                <Label Text="{Binding ErrorMessage}" 
                       TextColor="#E53935" 
                       FontSize="13"
                       FontAttributes="Bold"
                       HorizontalOptions="Center"
                       HorizontalTextAlignment="Center"
                       IsVisible="{Binding ErrorMessage, Converter={StaticResource IsNotNullOrEmptyConverter}}" />

                
                <Button Text="Anmelden" 
                        Command="{Binding LoginCommand}"
                        CornerRadius="8"
                        HeightRequest="48"
                        FontSize="16"
                        FontAttributes="Bold"
                        BackgroundColor="#2563EB"
                        TextColor="White" />

            </VerticalStackLayout>
        </Border>
    </Grid>
</ContentPage>